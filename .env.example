# ============================================================
# finetune-vs-rag-medqa — example Environment Variables for reference
# Copy this file to .env and fill in your actual values.
# ============================================================


#  OpenAI (used by RAGAS as LLM judge) ---------------------------------
# Get from: https://platform.openai.com/api-keys
# Note: RAGAS makes ~3 API calls per test sample — budget ~$1–2 for 100 samples
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



#  Hugging Face -------------------------------------------------
# Get from: https://huggingface.co/settings/tokens
# Needs read access to gated models (Llama 3.2)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



#  Langfuse (Observability) ----------------------------------------------------------
# Get from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL



#  Weights & Biases (Experiment Tracking) -------------------------------------
# Get from: https://wandb.ai/settings → Danger Zone → API Keys
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=finetune-vs-rag-medqa
WANDB_ENTITY=your-wandb-username




#  Model & Path Configuration ------------------------------------
BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
CHECKPOINT_DIR=./checkpoints/medquad-lora
FAISS_INDEX_PATH=./indexes/medquad_faiss

# FastAPI ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
