# ============================================================
# finetune-vs-rag-benchmark — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real API keys or tokens to git.
# ============================================================

# ── Dynamic LLM Judge Configuration (Highest Priority) ─────
# Provider options: local | groq | openrouter | gemini | openai
# Priority: CLI arguments (--judge-provider / --judge-model) > .env > defaults
JUDGE_PROVIDER=local
JUDGE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
JUDGE_DEVICE=auto
JUDGE_LOAD_IN_4BIT=true
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=1024

# ── Local / Kaggle Judge Examples ───────────────────────────
# Laptop (Local):
#   JUDGE_PROVIDER=local
#   JUDGE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
#
# Kaggle GPU (T4 / P100 / A100):
#   JUDGE_PROVIDER=local
#   JUDGE_MODEL=unsloth/Qwen2.5-14B-Instruct-bnb-4bit
#   # or: unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit

# ── External API Provider Keys & Models ─────────────────────
# Groq (Fast cloud inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (Multi-model gateway)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings Configuration ────────────────────────────────
# Uses local sentence-transformers (zero API cost, runs on CPU/GPU)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Hugging Face Hub (For gated models e.g. Llama-3.2) ───────
HF_TOKEN=hf_your_huggingface_token_here
HF_DATASET_NAME=lavita/ChatDoctor-HealthCareMagic-100k

# ── Observability & Experiment Tracking ──────────────────────
# Langfuse Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=finetune-vs-rag-benchmark
WANDB_ENTITY=your_wandb_entity

# ── Paths & Serving ─────────────────────────────────────────
BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
CHECKPOINT_DIR=./checkpoints/medquad-lora
FAISS_INDEX_PATH=./indexes/medquad_faiss
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
